# BigWigs packager: the release zip holds only the add-on.
# media/fonts (Roboto Condensed, Atkinson Hyperlegible Next and their licences) and media/icons ship.
package-as: Haggler
enable-nolib-creation: no
ignore:
  - dev
  - tests
  - tools
  - .claude
  - .luacheckrc
  - .stylua.toml
  - .styluaignore
  - media/screenshots
